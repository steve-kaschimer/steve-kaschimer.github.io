---
layout: base.njk
---

<!-- Hero with Background Image -->
{% if image %}
<header class="relative h-96 bg-gray-900 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <picture>
      <source srcset="{{ image | replace('.png', '.webp') }}" type="image/webp">
      <img src="{{ image }}" alt="{{ image_alt | default('') }}" class="w-full h-full object-cover opacity-60" loading="eager" decoding="async" width="1200" height="800">
    </picture>
  </div>

  <!-- Overlay Gradient -->
  <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-gray-900/80"></div>

  <!-- Title and Meta -->
  <div class="relative h-full flex flex-col justify-end max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 text-center">
      {{ title }}
    </h1>
    <div class="flex items-center justify-center gap-6 text-white/90">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
        </svg>
        <span>{{ author }}</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
        </svg>
        <time datetime="{{ date }}">{{ date | readableDate }}</time>
      </div>
    </div>
  </div>
</header>
{% else %}
<!-- Fallback Header without Image -->
<header class="bg-linear-to-r from-primary-600 to-primary-800 dark:from-primary-800 dark:to-primary-900 py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 text-center">
      {{ title }}
    </h1>
    <div class="flex items-center justify-center gap-6 text-white/90">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
        </svg>
        <span>{{ author }}</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
        </svg>
        <time datetime="{{ date }}">{{ date | readableDate }}</time>
      </div>
    </div>
  </div>
</header>
{% endif %}

<article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Post Content -->
  <div class="prose prose-lg dark:prose-invert max-w-none">
    {{ content | safe }}
  </div>

  <!-- Companion Source Code -->
  {% if companion_download %}
  <div class="callout-box mt-8">
    <h2 class="text-xl font-display font-bold mt-0 mb-2">Companion Source Code</h2>
    <p class="mb-4">This article is part of the <a href="/posts/2030-08-11-architecture-lab-introduction/">Northstar Architecture Lab</a>, a runnable companion .NET application built alongside this series.</p>
    <a href="{{ companion_download }}" class="btn btn-primary inline-flex items-center gap-2 no-underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
      </svg>
      Download {{ companion_download_label }}
    </a>
  </div>
  {% endif %}

  <!-- Back to Home -->
  <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
    <a href="/" class="inline-flex items-center text-primary-700 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-500">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
      </svg>
      Back to all posts
    </a>
  </div>
</article>
